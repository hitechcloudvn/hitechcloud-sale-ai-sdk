{
    "name": "hitechcloudvn/sale-ai-sdk",
    "description": "Official PHP SDK for the HiTechCloud Sale AI API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://developers.hitechcloud.vn/tai-lieu/sale-ai",
    "support": {
        "issues": "https://github.com/hitechcloudvn/hitechcloud-sale-ai-sdk/issues",
        "source": "https://github.com/hitechcloudvn/hitechcloud-sale-ai-sdk"
    },
    "authors": [
        { "name": "HiTechCloud Vietnam", "email": "support@hitechcloud.vn" }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": { "HiTechCloud\\SaleAI\\": "src/" },
        "files": ["src/Exceptions.php"]
    },
    "autoload-dev": {
        "psr-4": { "HiTechCloud\\SaleAI\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable"
}
