{
    "name": "hitechcloud-vietnam/sale-ai-sdk",
    "description": "Official PHP SDK for the HiTechCloud Sale AI API",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "HiTechCloud Vietnam", "email": "support@hitechcloud.vn" }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": { "HiTechCloud\\SaleAI\\": "src/" },
        "files": ["src/Exceptions.php"]
    },
    "autoload-dev": {
        "psr-4": { "HiTechCloud\\SaleAI\\Tests\\": "tests/" }
    },
    "minimum-stability": "stable"
}
